DB_HOST=
DB_NAME=despensa_app
DB_USER=app_user
DB_PASS=
APP_ENV=
APP_URL=
SESSION_LIFETIME=

# OCR de tickets. Si se omite, se busca tesseract en /usr/bin y /usr/local/bin.
# TESSERACT_BIN=/usr/bin/tesseract

# Google Stitch (diseño de referencia de controles e iconos).
# La clave se usa solo desde scripts/stitch.mjs; no se versiona.
STITCH_API_KEY=

# Admin inicial para scripts/seed.php.
# Si ADMIN_PASSWORD queda vacío se genera una temporal y se muestra al ejecutar el seed.
ADMIN_EMAIL=admin@misuper.local
ADMIN_PASSWORD=
